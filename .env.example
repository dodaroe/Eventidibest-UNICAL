; Copia questo file in .env e compila con i tuoi valori reali
; NON committare mai il file .env su Git
; I commenti iniziano con il punto e virgola. Valori con ; o " vanno tra virgolette: PASS="a;b"

DB_HOST=localhost
DB_USER=db_username
DB_PASS=db_password
DB_NAME=eventi_dibest
SIMPLESAML_PATH=/opt/simplesamlphp/lib/_autoload.php

; Chiave per avviare i cron via URL con wget o curl: script.php?key=CHIAVE
; Almeno 16 caratteri casuali. Non serve se il crontab usa php /percorso/script.php
; Indirizzo pubblico del portale, usato dai cron lanciati da riga di comando (lo imposta strumenti/migra_a_didattica.sh)
URL_SITO=https://dibest2.unical.it/didattica
CRON_KEY=

; --- Backup: admin/cron_backup.php ---
; Cartella del NAS montata sul server: ogni backup viene copiato in PERCORSO/eventi_dibest
BACKUP_NAS_PATH=
; Giorni di conservazione sul NAS - sul server restano 7 giorni
BACKUP_NAS_GIORNI=30
; Copia del solo database, cifrata AES-256, via email - uno o piu indirizzi separati da virgola
BACKUP_EMAIL=
; settimanale = il lunedi, giornaliera, no
BACKUP_EMAIL_FREQUENZA=settimanale
; Password dello ZIP cifrato, almeno 12 caratteri. Conservala anche fuori dal server
BACKUP_PASSWORD=

; --- Conservazione dei dati (cron_background.php, descritta in privacy.php) ---
; Registri tecnici (accessi con IP e browser, email inviate), in mesi
CONSERVAZIONE_LOG_MESI=12
; Registro delle azioni amministrative, in mesi
CONSERVAZIONE_AUDIT_MESI=24
; Prenotazioni anonimizzate N mesi dopo l'attività (0 = mai). Da concordare con il DPO
CONSERVAZIONE_PRENOTAZIONI_MESI=0
; Account senza accessi da N mesi eliminati, esclusi amministratori e gestori (0 = mai). Da concordare con il DPO
CONSERVAZIONE_UTENTI_MESI=0

; --- Tutorato: lettere di incarico (admin/tutorato.php) ---
; Lo studente conferma la lettera solo se è entrato con SPID o CIE (1, consigliato). 0 = anche con le credenziali di Ateneo
INCARICHI_SOLO_SPID_CIE=1
; Firma remota Aruba (ArubaSignService) per firmare in PAdES dal portale. Vuoto = docente e direttore caricano il PDF firmato.
; Indirizzo del servizio SOAP fornito da Aruba all'Ateneo, es. https://arss.arubapec.it/ArubaSignService/ArubaSignService
ARUBA_ARSS_URL=
; Dominio di autenticazione OTP (typeOtpAuth) indicato da Aruba per le firme remote dell'Ateneo
ARUBA_ARSS_DOMINIO=frRESIGN
; Identificativo del certificato di firma (di solito AS0)
ARUBA_ARSS_CERTID=AS0
